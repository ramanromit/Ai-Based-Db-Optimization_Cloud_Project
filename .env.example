# ═══════════════════════════════════════════════════════════════════
# CAQI Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════════

# ── Local Development (USE_AWS=false, default) ──────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=caqi
POSTGRES_USER=caqi_admin
POSTGRES_PASSWORD=caqi_secret
DATABASE_URL=postgresql://caqi_admin:caqi_secret@localhost:5432/caqi

# ── AWS Mode Toggle ─────────────────────────────────────────────────
# Set to "true" to route DB traffic through AWS (RDS Proxy + Aurora).
# When true, RDS_PROXY_ENDPOINT and AURORA_READER_ENDPOINT MUST be set.
USE_AWS=false

# ── Phase 2 — AWS Aurora + RDS Proxy endpoints ──────────────────────
# Get these values from: terraform output  (in infra/terraform/)
# RDS_PROXY_ENDPOINT is the writer path — ALL write traffic goes here.
# AURORA_READER_ENDPOINT is the reader path — analytical queries only.
RDS_PROXY_ENDPOINT=
AURORA_READER_ENDPOINT=

# Aurora DB credentials (must match terraform variables db_master_username / db_master_password)
DB_NAME=caqi
DB_USERNAME=caqi_admin
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── AWS Credentials (Learner Lab — rotate every 4 hours) ────────────
# Copy from AWS Details → AWS CLI → Show in the Learner Lab portal.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# ── Phase 1 AWS Service Identifiers ─────────────────────────────────
# Get these from: terraform output  (in infra/terraform/)
SQS_QUEUE_URL=
SNS_TOPIC_ARN=
DYNAMODB_TABLE_NAME=caqi-idempotency-keys
CLOUDWATCH_NAMESPACE=CAQI/Metrics

# ── SLA Budgets (milliseconds) ───────────────────────────────────────
AUTH_SLA_BUDGET_MS=10.0
SETTLEMENT_SLA_BUDGET_MS=150.0
ANALYTICAL_SLA_BUDGET_MS=1000.0

# ── Explainability ───────────────────────────────────────────────────
EXPLAINABILITY_DB_PATH=caqi_explainability.sqlite
